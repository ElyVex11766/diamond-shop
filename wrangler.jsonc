{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "diamond-shop",
  "main": "worker.js",
  "compatibility_date": "2024-01-01",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "diamond-bot",
      "database_id": "7ee5dd9f-c4ee-4d91-bdf2-7282ed58808f"
    }
  ]
}
